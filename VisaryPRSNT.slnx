<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/Visary.Core/Visary.Core.csproj">
      <Platform Project="Any CPU" />
    </Project>
    <Project Path="src/Visary.App/Visary.App.csproj">
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Visary.Core.Tests/Visary.Core.Tests.csproj">
      <Platform Project="Any CPU" />
    </Project>
  </Folder>
</Solution>
